{
  "name": "@geohar/pi-mcp-combiner",
  "version": "0.14.3",
  "description": "Pi extension: run the mcp-combiner MCP aggregator via sharedserver and inject its tool-discovery directive. Pairs with pi-mcp-adapter, which makes the combiner's tools reachable from Pi.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/georgeharker/mcp-companion/main/plugins/pi/assets/preview.png"
  },
  "files": [
    "src",
    "dist",
    "instructions.txt",
    "mcp.json.example",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "node -e \"require('fs').copyFileSync('../../CLAUDE.md.example', './instructions.txt')\"",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-mono",
    "mcp",
    "mcp-combiner",
    "sharedserver",
    "extension"
  ],
  "author": "George Harker <george@georgeharker.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgeharker/mcp-companion.git",
    "directory": "plugins/pi"
  },
  "bugs": {
    "url": "https://github.com/georgeharker/mcp-companion/issues"
  },
  "homepage": "https://github.com/georgeharker/mcp-companion/tree/main/plugins/pi#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-tui": "^0.85.1"
  }
}
